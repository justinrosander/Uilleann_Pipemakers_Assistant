# PostgreSQL. Run py scripts/setup_postgres.py to create the database and fill this in.
# Put the password in the URL, or leave it out and set the keyring variables below.
DATABASE_URL=postgresql://user@localhost:5432/up_db
DATABASE_KEYRING_SERVICE=
DATABASE_KEYRING_USER=

# SpaceXAI / xAI (optional for LLM-assisted layout hints; core validation is deterministic)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7

# Path to the canonical measurement template
TEMPLATE_PATH=UP_measurement_template.xlsx
